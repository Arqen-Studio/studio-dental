# Enquiry form. Set these in the Vercel project settings, never in the repo.
#
# RESEND_API_KEY is required, from resend.com. Without it the form fails
# loudly and tells the patient to phone instead, rather than silently
# discarding the enquiry.
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to thestudiodentalclinic@gmail.com.
ENQUIRY_TO=

# The From address. Must be on a domain verified with Resend. Until a domain
# is verified, leaving this unset uses Resend's shared sending address, which
# works but is more likely to land in spam.
ENQUIRY_FROM=
